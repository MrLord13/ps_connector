<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ps_connector" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ps.connector</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="Product Selector Connector">
                <sheet>
                    <group string="External Service">
                        <field name="ps_connector_protocol"/>
                        <field name="ps_connector_host" placeholder="product-selector.example.com"/>
                        <field name="ps_connector_port"/>
                        <field name="ps_connector_endpoint"/>
                        <field name="ps_connector_timeout"/>
                    </group>
                    <group string="Authentication">
                        <field name="ps_connector_shared_secret" password="True"/>
                        <field name="ps_connector_token_expiry"/>
                    </group>
                </sheet>
                <footer>
                    <button name="execute" type="object" string="Save" class="btn-primary"/>
                    <button special="cancel" string="Discard" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="res_config_settings_action_ps_connector" model="ir.actions.act_window">
        <field name="name">Product Selector Connector</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="res_config_settings_view_form_ps_connector"/>
    </record>

    <menuitem id="menu_ps_connector_settings"
              name="Product Selector Connector"
              parent="base.menu_administration"
              action="res_config_settings_action_ps_connector"
              groups="base.group_system"
              sequence="60"/>
</odoo>
