<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_ps_connector" model="ir.ui.view">
        <field name="name">crm.lead.form.ps.connector</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_to_ps_connector"
                        type="object"
                        string="Send to Product Selector"
                        class="btn-secondary"
                        invisible="type != 'opportunity'"
                        confirm="Send this opportunity's customer data to the Product Selector service?"/>
            </xpath>
        </field>
    </record>
</odoo>
