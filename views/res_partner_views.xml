<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_ps_connector" model="ir.ui.view">
        <field name="name">res.partner.form.ps.connector</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Product Selector" name="ps_connector">
                    <group>
                        <group string="Contact Details Sent to Product Selector">
                            <field name="ps_title"/>
                            <field name="ps_ext"/>
                            <field name="ps_fax"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
