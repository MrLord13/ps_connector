<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ps_connector_preview_view_form" model="ir.ui.view">
        <field name="name">ps.connector.preview.form</field>
        <field name="model">ps.connector.preview</field>
        <field name="arch" type="xml">
            <form string="What will be sent to the Product Selector">
                <group>
                    <field name="lead_id" invisible="1"/>
                    <field name="target_url"/>
                    <field name="encoding"/>
                    <field name="problem_count" string="Required fields still empty"/>
                </group>
                <field name="report" nolabel="1" readonly="1"
                       class="font-monospace" style="white-space: pre;"/>
                <footer>
                    <button name="action_send" type="object" string="Send Now"
                            class="btn-primary"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
